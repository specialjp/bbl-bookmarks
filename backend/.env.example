# Auth0 — issuer keeps its TRAILING SLASH (Auth0 mints `iss` with it; ADR-013)
AUTH0_ISSUER=https://dev-yg.us.auth0.com/
AUTH0_AUDIENCE=https://bbl-candidate-test-api
# Separate variable (not derived from issuer) so tests can point it at a mocked JWKS
AUTH0_JWKS_URI=https://dev-yg.us.auth0.com/.well-known/jwks.json

# PostgreSQL (docker compose up -d db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookmarks?schema=public

PORT=3001
